<!DOCTYPE html>
<html>
<head>
    <title>Nazeer Micro Irrigation Agency</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            background: #ffffff;
            overflow-x: hidden;
        }

        /* Scroll container spacing */
        .section {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Glass Box Style */
        .glass-box {
            width: 70%;
            max-width: 800px;
            padding: 60px;
            border-radius: 25px;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: all 0.5s ease;
            opacity: 0;
            transform: translateY(80px);
        }

        /* Frosted hover effect */
        .glass-box:hover {
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            background: rgba(255, 255, 255, 0.6);
            transform: scale(1.03);
        }

        h1 {
            margin: 0;
            font-size: 42px;
            font-weight: 600;
            color: #111;
        }

        p {
            margin-top: 15px;
            font-size: 18px;
            color: #444;
        }

        /* Reveal Animation */
        .show {
            opacity: 1;
            transform: translateY(0);
            transition: all 1s ease;
        }
    </style>
</head>
<body>

    <!-- FIRST BOX -->
    <div class="section">
        <div class="glass-box reveal">
            <h1>Nazeer Micro Irrigation Agency</h1>
            <p>Precision Watering. Smarter Farming. Sustainable Future.</p>
        </div>
    </div>

    <!-- SECOND EMPTY BOX FOR FUTURE -->
    <div class="section">
        <div class="glass-box reveal">
            <h1>Coming Soon</h1>
            <p>More sections will appear here as we build...</p>
        </div>
    </div>

    <script>
        // Scroll Reveal Effect
        const reveals = document.querySelectorAll(".reveal");

        function revealOnScroll() {
            const windowHeight = window.innerHeight;

            reveals.forEach(reveal => {
                const elementTop = reveal.getBoundingClientRect().top;

                if (elementTop < windowHeight - 100) {
                    reveal.classList.add("show");
                }
            });
        }

        window.addEventListener("scroll", revealOnScroll);
        revealOnScroll();
    </script>

</body>
</html>
